# Preset: go (any Go service; Playwright e2e lives in ./e2e as a small Node package)

# --- Per-file (edit hook) ---
FORMAT_EXTENSIONS="go"
FORMAT_FILE_CMD='gofmt -w'
LINT_EXTENSIONS=""
LINT_FILE_CMD=''

# --- Stop hook ---
STOP_CHECKS="typecheck lint test"

# --- Project tasks ---
SETUP_CMD='go mod download'
DEV_CMD='go run ./cmd/server'
FORMAT_CMD='gofmt -w .'
FORMAT_CHECK_CMD='out="$(gofmt -l .)"; [ -z "$out" ] || { echo "Not gofmt-formatted:"; echo "$out"; exit 1; }'
LINT_CMD='golangci-lint run ./...'
TYPECHECK_CMD='go vet ./...'
TEST_CMD='go test -race -count=1 ./...'
TEST_E2E_SETUP_CMD='cd e2e && npm ci && npx playwright install --with-deps chromium'
TEST_E2E_CMD='cd e2e && npx playwright test'
BUILD_CMD='go build ./...'
AUDIT_CMD='go run golang.org/x/vuln/cmd/govulncheck@latest ./...'
DB_MIGRATE_CMD='goose -dir migrations postgres "$DATABASE_URL" up'
DB_SEED_CMD='go run ./cmd/seed'
