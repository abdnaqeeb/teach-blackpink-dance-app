# Preset: java (Spring Boot with Gradle wrapper; Spotless + Checkstyle/Error Prone configured in build.gradle.kts)

# --- Per-file (edit hook) ---
# Gradle is too slow to run per edit; the Stop hook and CI cover formatting and lint.
FORMAT_EXTENSIONS=""
FORMAT_FILE_CMD=''
LINT_EXTENSIONS=""
LINT_FILE_CMD=''

# --- Stop hook ---
STOP_CHECKS="typecheck test"

# --- Project tasks ---
SETUP_CMD='./gradlew --quiet dependencies > /dev/null'
DEV_CMD='./gradlew bootRun'
FORMAT_CMD='./gradlew spotlessApply'
FORMAT_CHECK_CMD='./gradlew spotlessCheck'
LINT_CMD='./gradlew checkstyleMain checkstyleTest'
TYPECHECK_CMD='./gradlew compileJava compileTestJava'
TEST_CMD='./gradlew test'
TEST_E2E_SETUP_CMD=''
TEST_E2E_CMD='./gradlew e2eTest'
BUILD_CMD='./gradlew build -x test'
AUDIT_CMD='osv-scanner scan source --recursive .'
DB_MIGRATE_CMD='./gradlew flywayMigrate'
DB_SEED_CMD=''
