# Preset: node-typescript (Next.js / React / any Node + TypeScript project)
# Values in single quotes are run later by bash; the file path is appended to *_FILE_CMD.

# --- Per-file (edit hook) ---
FORMAT_EXTENSIONS="ts tsx js jsx mjs cjs json css md mdx yml yaml"
FORMAT_FILE_CMD='node_modules/.bin/prettier --write --log-level=warn'
LINT_EXTENSIONS="ts tsx js jsx mjs cjs"
LINT_FILE_CMD='node_modules/.bin/eslint --fix --max-warnings=0'

# --- Stop hook: fast checks run before Claude may finish ---
STOP_CHECKS="typecheck lint test"

# --- Project tasks (empty = not applicable) ---
SETUP_CMD='npm ci'
DEV_CMD='npm run dev'
FORMAT_CMD='npx prettier --write .'
FORMAT_CHECK_CMD='npx prettier --check .'
LINT_CMD='npx eslint . --max-warnings=0'
TYPECHECK_CMD='npx tsc --noEmit'
TEST_CMD='npx vitest run'
TEST_E2E_SETUP_CMD='npx playwright install --with-deps chromium'
TEST_E2E_CMD='npx playwright test'
BUILD_CMD='npm run build'
AUDIT_CMD='npm audit --omit=dev --audit-level=high'
DB_MIGRATE_CMD='npx drizzle-kit migrate'
DB_SEED_CMD='npx tsx scripts/seed.ts'
