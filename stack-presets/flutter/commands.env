# Preset: flutter (Flutter + Dart, iOS and Android)

# --- Per-file (edit hook) ---
FORMAT_EXTENSIONS="dart"
FORMAT_FILE_CMD='dart format'
LINT_EXTENSIONS="dart"
LINT_FILE_CMD='dart analyze --fatal-infos'

# --- Stop hook ---
STOP_CHECKS="lint test"

# --- Project tasks ---
SETUP_CMD='flutter pub get'
DEV_CMD='flutter run'
FORMAT_CMD='dart format .'
FORMAT_CHECK_CMD='dart format --output=none --set-exit-if-changed .'
LINT_CMD='flutter analyze --fatal-infos'
TYPECHECK_CMD=''   # covered by flutter analyze
TEST_CMD='flutter test'
# Needs a running simulator/emulator (macOS runner for iOS, Android emulator on Linux).
TEST_E2E_SETUP_CMD=''
TEST_E2E_CMD='flutter test integration_test'
BUILD_CMD='flutter build apk --debug'
AUDIT_CMD='osv-scanner scan source --recursive .'
DB_MIGRATE_CMD=''
DB_SEED_CMD=''
