# Preset: android-kotlin (Jetpack Compose app, Gradle wrapper; ktlint + detekt Gradle plugins)

# --- Per-file (edit hook) ---
FORMAT_EXTENSIONS="kt kts"
FORMAT_FILE_CMD='ktlint --format --relative'
LINT_EXTENSIONS=""
LINT_FILE_CMD=''

# --- Stop hook ---
STOP_CHECKS="typecheck test"

# --- Project tasks ---
SETUP_CMD='./gradlew --quiet help'
DEV_CMD='./gradlew installDebug'
FORMAT_CMD='./gradlew ktlintFormat'
FORMAT_CHECK_CMD='./gradlew ktlintCheck'
LINT_CMD='./gradlew detekt lintDebug'
TYPECHECK_CMD='./gradlew compileDebugKotlin compileDebugUnitTestKotlin'
TEST_CMD='./gradlew testDebugUnitTest'
# Needs an emulator (e.g. reactivecircus/android-emulator-runner in CI) or use Maestro.
TEST_E2E_SETUP_CMD=''
TEST_E2E_CMD='./gradlew connectedDebugAndroidTest'
BUILD_CMD='./gradlew assembleDebug'
AUDIT_CMD='osv-scanner scan source --recursive .'
DB_MIGRATE_CMD=''
DB_SEED_CMD=''
