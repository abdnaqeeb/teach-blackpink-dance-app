# Preset: dotnet (ASP.NET Core / any .NET solution in the repo root)

# --- Per-file (edit hook) ---
# dotnet format is too slow to run per edit; the Stop hook and CI catch formatting instead.
FORMAT_EXTENSIONS=""
FORMAT_FILE_CMD=''
LINT_EXTENSIONS=""
LINT_FILE_CMD=''

# --- Stop hook ---
STOP_CHECKS="typecheck test"

# --- Project tasks ---
SETUP_CMD='dotnet restore'
DEV_CMD='dotnet watch --project src/Api'
FORMAT_CMD='dotnet format'
FORMAT_CHECK_CMD='dotnet format --verify-no-changes'
LINT_CMD='dotnet format analyzers --verify-no-changes --severity warn'
TYPECHECK_CMD='dotnet build --no-restore -warnaserror'
TEST_CMD='dotnet test --no-restore --filter "Category!=E2E"'
TEST_E2E_SETUP_CMD=''
TEST_E2E_CMD='dotnet test --no-restore --filter "Category=E2E"'
BUILD_CMD='dotnet build -c Release'
AUDIT_CMD='out="$(dotnet list package --vulnerable --include-transitive 2>&1)"; echo "$out"; ! echo "$out" | grep -q "has the following vulnerable packages"'
DB_MIGRATE_CMD='dotnet ef database update --project src/Infrastructure --startup-project src/Api'
DB_SEED_CMD='dotnet run --project tools/Seed'
