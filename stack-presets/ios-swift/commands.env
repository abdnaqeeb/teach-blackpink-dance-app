# Preset: ios-swift (SwiftUI app, Xcode project). Needs macOS (set repo variable CI_RUNNER=macos-latest).
# Set your scheme and simulator here:
IOS_SCHEME="App"
IOS_DEST="platform=iOS Simulator,name=iPhone 16"

# --- Per-file (edit hook) ---
FORMAT_EXTENSIONS="swift"
FORMAT_FILE_CMD='swift format --in-place'
LINT_EXTENSIONS="swift"
LINT_FILE_CMD='swiftlint lint --strict --quiet'

# --- Stop hook (xcodebuild is slow; keep this to lint + unit tests) ---
STOP_CHECKS="lint test"

# --- Project tasks ---
SETUP_CMD='xcodebuild -resolvePackageDependencies -scheme "$IOS_SCHEME"'
DEV_CMD='open *.xcodeproj'
FORMAT_CMD='swift format --in-place --recursive .'
FORMAT_CHECK_CMD='swift format lint --strict --recursive .'
LINT_CMD='swiftlint lint --strict --quiet'
TYPECHECK_CMD=''   # the compiler covers it in build/test
TEST_CMD='xcodebuild test -quiet -scheme "$IOS_SCHEME" -destination "$IOS_DEST" -only-testing:AppTests'
TEST_E2E_SETUP_CMD=''
TEST_E2E_CMD='xcodebuild test -quiet -scheme "$IOS_SCHEME" -destination "$IOS_DEST" -only-testing:AppUITests'
BUILD_CMD='xcodebuild build -quiet -scheme "$IOS_SCHEME" -destination "$IOS_DEST"'
AUDIT_CMD='osv-scanner scan source --recursive .'
DB_MIGRATE_CMD=''
DB_SEED_CMD=''
