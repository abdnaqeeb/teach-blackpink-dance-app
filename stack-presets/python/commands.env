# Preset: python (FastAPI / Django / any Python project managed with uv)

# --- Per-file (edit hook) ---
FORMAT_EXTENSIONS="py pyi"
FORMAT_FILE_CMD='uv run --quiet ruff format'
LINT_EXTENSIONS="py pyi"
LINT_FILE_CMD='uv run --quiet ruff check --fix'

# --- Stop hook ---
STOP_CHECKS="typecheck lint test"

# --- Project tasks ---
SETUP_CMD='uv sync --frozen'
DEV_CMD='uv run fastapi dev app/main.py'
FORMAT_CMD='uv run ruff format .'
FORMAT_CHECK_CMD='uv run ruff format --check .'
LINT_CMD='uv run ruff check .'
TYPECHECK_CMD='uv run mypy .'
TEST_CMD='uv run pytest -q --ignore=tests/e2e'
TEST_E2E_SETUP_CMD='uv run playwright install --with-deps chromium'
TEST_E2E_CMD='uv run pytest -q tests/e2e'
BUILD_CMD='uv build'
AUDIT_CMD='uv export --no-dev --no-hashes --no-emit-project --format requirements-txt -o .audit-req.txt && uvx pip-audit --strict -r .audit-req.txt; rc=$?; rm -f .audit-req.txt; exit $rc'
DB_MIGRATE_CMD='uv run alembic upgrade head'
DB_SEED_CMD='uv run python -m scripts.seed'
