# Preset: expo-react-native (Expo SDK + React Native + TypeScript)

# --- Per-file (edit hook) ---
FORMAT_EXTENSIONS="ts tsx js jsx json md yml yaml"
FORMAT_FILE_CMD='node_modules/.bin/prettier --write --log-level=warn'
LINT_EXTENSIONS="ts tsx js jsx"
LINT_FILE_CMD='node_modules/.bin/eslint --fix --max-warnings=0'

# --- Stop hook ---
STOP_CHECKS="typecheck lint test"

# --- Project tasks ---
SETUP_CMD='npm ci'
DEV_CMD='npx expo start'
FORMAT_CMD='npx prettier --write .'
FORMAT_CHECK_CMD='npx prettier --check .'
LINT_CMD='npx eslint . --max-warnings=0'
TYPECHECK_CMD='npx tsc --noEmit'
TEST_CMD='npx jest --ci'
# E2E needs a simulator/emulator with a dev build installed. Run on a macOS/Android runner,
# or use Maestro Cloud / EAS Workflows (see STACK.md).
TEST_E2E_SETUP_CMD=''
TEST_E2E_CMD='maestro test .maestro/'
# Validates config and that the JS bundle builds for both platforms (fast, no native build).
BUILD_CMD='npx expo-doctor && npx expo export --platform ios --platform android --output-dir .expo-export-check && rm -rf .expo-export-check'
AUDIT_CMD='npm audit --omit=dev --audit-level=high'
DB_MIGRATE_CMD=''
DB_SEED_CMD=''
