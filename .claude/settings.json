{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./scripts/task.sh *)",
      "Bash(scripts/task.sh *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npx expo install *)",
      "Bash(npx shadcn *)",
      "Bash(pnpm add *)",
      "Bash(yarn add *)",
      "Bash(pip install *)",
      "Bash(uv add *)",
      "Bash(uv remove *)",
      "Bash(poetry add *)",
      "Bash(go get *)",
      "Bash(dotnet add *)",
      "Bash(cargo add *)",
      "Bash(flutter pub add *)",
      "Bash(dart pub add *)",
      "Bash(pod install *)",
      "Bash(git push *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(eas build *)",
      "Bash(eas update *)",
      "Bash(fastlane *)",
      "Edit(./**/auth/**)",
      "Edit(./**/authz/**)",
      "Edit(./**/security/**)",
      "Edit(./**/permissions/**)",
      "Edit(./**/migrations/**)",
      "Edit(./**/migration/**)",
      "Edit(./drizzle/**)",
      "Edit(./prisma/**)",
      "Edit(./alembic/**)",
      "Edit(./**/middleware.*)",
      "Edit(./design/**)",
      "Edit(./.github/**)",
      "Edit(./.claude/**)",
      "Edit(./.project/**)",
      "Edit(./scripts/task.sh)",
      "Edit(./CLAUDE.md)",
      "Edit(./mise.toml)",
      "Edit(./package.json)",
      "Edit(./pyproject.toml)",
      "Edit(./go.mod)",
      "Edit(./**/*.csproj)",
      "Edit(./Directory.Packages.props)",
      "Edit(./**/build.gradle*)",
      "Edit(./gradle/libs.versions.toml)",
      "Edit(./pom.xml)",
      "Edit(./Cargo.toml)",
      "Edit(./pubspec.yaml)",
      "Edit(./Package.swift)",
      "Edit(./app.json)",
      "Edit(./app.config.*)",
      "Edit(./eas.json)",
      "Edit(./**/Info.plist)",
      "Edit(./**/*.entitlements)",
      "Edit(./**/PrivacyInfo.xcprivacy)",
      "Edit(./**/AndroidManifest.xml)",
      "Edit(./**/network_security_config.xml)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./.env.test.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.p8)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/google-services.json)",
      "Read(./**/GoogleService-Info.plist)",
      "Read(./**/appsettings.Production.json)",
      "Bash(cat .env*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main*)",
      "Bash(git reset --hard *)",
      "Bash(rm -rf *)",
      "Bash(npm publish *)",
      "Bash(vercel --prod *)",
      "Bash(eas submit *)",
      "Bash(eas update --branch production*)",
      "Bash(eas update --channel production*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-and-lint-file.sh",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/verify-on-stop.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
