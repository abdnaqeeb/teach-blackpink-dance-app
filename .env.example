# Copy to .env (or .env.local) and fill in. Never commit real values.
# Every variable here must also be declared in the config module (see CLAUDE.md → Stack specifics).
# Anything a browser or mobile app can see is PUBLIC. Keep secrets in the "server only" block.

# --- Server only (secrets) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/app_dev
AUTH_SECRET_KEY=            # auth provider secret / API key (test mode locally)
PAYMENTS_SECRET_KEY=        # e.g. Stripe sk_test_...
PAYMENTS_WEBHOOK_SECRET=    # webhook signing secret
ERROR_MONITORING_AUTH_TOKEN=  # build-time only, for source maps / dSYMs

# --- Public (shipped to clients; use your framework's public prefix,
#     e.g. NEXT_PUBLIC_, EXPO_PUBLIC_, VITE_, or --dart-define / xcconfig / BuildConfig) ---
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000
PUBLIC_AUTH_PUBLISHABLE_KEY=
PUBLIC_ERROR_MONITORING_DSN=
